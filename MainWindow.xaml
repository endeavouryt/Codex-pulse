<Window x:Class="CodexPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Pulse"
        Width="124"
        Height="64"
        MinWidth="124"
        MinHeight="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        ShowActivated="False"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.ToolTip>
        <ToolTip x:Name="PulseToolTip" Placement="Mouse" />
    </Window.ToolTip>

    <Grid x:Name="GlassCard"
          Margin="4"
          Background="#88FFFFFF"
          MouseLeftButtonDown="GlassCard_MouseLeftButtonDown">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30"
                              Direction="270"
                              ShadowDepth="1"
                              Opacity="0.055"
                              Color="#7D8C9B" />
        </Grid.Effect>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="立即刷新" Click="RefreshMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ShowFiveHourMenuItem" Header="显示 5hr limit" IsCheckable="True" IsChecked="True" Click="ShowFiveHourMenuItem_Click" />
                <MenuItem x:Name="StartupMenuItem" Header="开机启动" IsCheckable="True" Click="StartupMenuItem_Click" />
                <Separator />
                <MenuItem Header="退出 Codex Pulse" Click="ExitMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid Margin="6,7,5,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FiveHourRow" Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="FiveHourLabel" Text="5 hr"
                           FontFamily="Consolas"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#71808E"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="FiveHourValueText"
                           Grid.Row="0"
                           Grid.Column="2"
                           Text="—"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#233446"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="1"
                           Text="Week"
                           FontFamily="Consolas"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#71808E"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="WeeklyValueText"
                           Grid.Row="1"
                           Grid.Column="2"
                           Text="—"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#233446"
                           VerticalAlignment="Center" />

                <Grid Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="3"
                      Width="20"
                      Margin="4,0,0,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
                    <Ellipse x:Name="IdleIcon"
                             Width="12"
                             Height="12"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stroke="#71808E"
                             StrokeThickness="1.35" />
                    <Path x:Name="WorkingIcon"
                          Width="17"
                          Height="17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 8.5,1.8 A 6.7,6.7 0 1 0 14.8,6"
                          Stroke="#547187"
                          StrokeThickness="1.45"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" />
                        </Path.RenderTransform>
                    </Path>
                    <Grid x:Name="CompletedIcon"
                          Width="17"
                          Height="17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <Ellipse Width="15"
                                 Height="15"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stroke="#3D806F"
                                 StrokeThickness="1.15" />
                        <Path Width="17"
                              Height="17"
                              Data="M 4.1,8.7 L 7.2,11.6 L 13.1,5.6"
                              Stroke="#3D806F"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                </Grid>
        </Grid>
    </Grid>
</Window>
